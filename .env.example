# Copy this to .env and change what you need.

# Where Receipts keeps everything on the server.
RECEIPTS_DIR=/srv/receipts

# Only if you build on a different computer than the server: the same folder
# as that computer sees it, e.g. a network share.
#RECEIPTS_SHARE=//server/data/receipts

# Your time zone, date style on receipts (MDY for 03/14, DMY for 14/03) and
# currency.
TZ=UTC
DATE_ORDER=MDY
CURRENCY=USD

# Change a port only if something else on the server already uses it.
#HTTP_PORT=8490
#APP_PORT=8491

# Optional HTTPS for phones (see docs/setup.md). Not needed to use the app.
#RECEIPTS_HOST=192.168.1.10
#HTTPS_PORT=8493
#CADDY_ADMIN_PORT=2493
