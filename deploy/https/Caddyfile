# Receipts' HTTPS front (docs/setup.md). The ports and the hostname come from
# the environment (deploy/https/zima.json); the defaults are below.
#
#   https://<RECEIPTS_HOST>:8493   the app, with a Let's Encrypt certificate that
#                                  deploy/https/run.sh fetches, so phones need
#                                  nothing installed. The name points at the
#                                  box's LAN address in DNS.
#
# LAN only: anything from a public address, or relayed by a Cloudflare tunnel,
# is dropped.
{
	# Only on the server's loopback, for the certificate renewal's reload.
	admin localhost:{$CADDY_ADMIN_PORT:2493}
	auto_https disable_redirects
}

(app) {
	@outside {
		not remote_ip private_ranges
	}
	@tunnel header Cf-Connecting-Ip *
	abort @outside
	abort @tunnel

	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		-Server
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}
	reverse_proxy 127.0.0.1:{$APP_PORT:8491}
}

# Loopback only: zima-hub's own LAN port for this app (deploy/https/zima.json)
# proxies here.
http://127.0.0.1:{$HTTP_PORT:8490} {
	import app
}

https://{$RECEIPTS_HOST}:{$HTTPS_PORT:8493} {
	tls /data/lego/certificates/{$RECEIPTS_HOST}.crt /data/lego/certificates/{$RECEIPTS_HOST}.key
	import app
}
